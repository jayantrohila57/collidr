{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "SKIP_ENV_VALIDATION=1 next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "gen:mcp-tools": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres node --import tsx scripts/generate-mcp-tool-pages.ts",
    "postinstall": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres node --import tsx scripts/generate-mcp-tool-pages.ts && node --input-type=module -e \"import('fumadocs-mdx/next').then((m) => m.postInstall())\""
  },
  "dependencies": {
    "@collidr/actions": "workspace:*",
    "@collidr/api": "workspace:*",
    "@collidr/ui": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.0.7",
    "fumadocs-mdx": "^13.0.5",
    "fumadocs-ui": "^16.0.7",
    "lucide-react": "^0.546.0",
    "next": "catalog:",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@collidr/config": "workspace:*",
    "tsx": "^4.20.5",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.10",
    "typescript": "catalog:"
  }
}
