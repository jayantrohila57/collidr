{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
  "globalEnv": [
    "ORGANIZATIONS_ENABLED",
    "NEXT_PUBLIC_ORGANIZATIONS_ENABLED",
    "NOTIFICATIONS_ENABLED",
    "NEXT_PUBLIC_NOTIFICATIONS_ENABLED",
    "VARIABLES_V2_ENABLED",
    "NEXT_PUBLIC_VARIABLES_V2_ENABLED",
    "ACTIONS_AUDIT_ENABLED",
    "NEXT_PUBLIC_ACTIONS_AUDIT_ENABLED",
    "SOFT_DELETES_ENABLED",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXT_PUBLIC_STUDIO_URL",
    "NEXT_PUBLIC_ACCOUNT_URL",
    "NEXT_PUBLIC_MCP_URL",
    "NEXT_PUBLIC_WWW_URL",
    "NEXT_PUBLIC_CONSOLE_URL",
    "NEXT_PUBLIC_SUPPORT_URL",
    "CONSOLE_ALLOWED_EMAILS",
    "MCP_RESOURCE_URL",
    "MCP_RATE_LIMIT_WINDOW_MS",
    "MCP_RATE_LIMIT_MAX_REQUESTS",
    "PLATFORM_AUTH_ENABLE_MCP",
    "VERCEL_SERVICES",
    "PLATFORM_PUBLIC_ORIGIN",
    "NEXT_PUBLIC_PLATFORM_ORIGIN",
    "AUTH_SERVICE_URL",
    "MCP_SERVICE_URL",
    "NEXT_BASE_PATH",
    "NEXT_PUBLIC_SUPPORT_URL",
    "NEXT_PUBLIC_DOCS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "CORS_ORIGIN",
        "SKIP_ENV_VALIDATION",
        "ENCRYPTION_KEY",
        "ORGANIZATIONS_ENABLED",
        "NEXT_PUBLIC_ORGANIZATIONS_ENABLED",
        "NOTIFICATIONS_ENABLED",
        "NEXT_PUBLIC_NOTIFICATIONS_ENABLED",
        "VARIABLES_V2_ENABLED",
        "NEXT_PUBLIC_VARIABLES_V2_ENABLED",
        "ACTIONS_AUDIT_ENABLED",
        "NEXT_PUBLIC_ACTIONS_AUDIT_ENABLED",
        "SOFT_DELETES_ENABLED",
        "E2E_TEST_MODE",
        "E2E_TEST_SECRET",
        "NEXT_PUBLIC_AUTH_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "NEXT_PUBLIC_ACCOUNT_URL",
        "NEXT_PUBLIC_MCP_URL",
        "NEXT_PUBLIC_WWW_URL",
        "NEXT_PUBLIC_CONSOLE_URL",
        "NEXT_PUBLIC_SUPPORT_URL",
        "CONSOLE_ALLOWED_EMAILS",
        "MCP_RESOURCE_URL",
        "MCP_RATE_LIMIT_WINDOW_MS",
        "MCP_RATE_LIMIT_MAX_REQUESTS",
        "PLATFORM_AUTH_ENABLE_MCP",
        "VERCEL_SERVICES",
        "PLATFORM_PUBLIC_ORIGIN",
        "NEXT_PUBLIC_PLATFORM_ORIGIN",
        "AUTH_SERVICE_URL",
        "MCP_SERVICE_URL",
        "NEXT_BASE_PATH",
        "NEXT_PUBLIC_SUPPORT_URL",
        "NEXT_PUBLIC_DOCS_URL",
        "NODE_OPTIONS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["SKIP_ENV_VALIDATION", "DATABASE_URL", "DATABASE_URL_POOLED"]
    },
    "a11y": {
      "dependsOn": ["^a11y"],
      "inputs": ["$TURBO_DEFAULT$", "e2e/**", "playwright.config.ts"],
      "env": [
        "CI",
        "SKIP_ENV_VALIDATION",
        "PLAYWRIGHT_BASE_URL",
        "PORT",
        "E2E_USE_PROD_SERVER",
        "E2E_TEST_MODE",
        "E2E_TEST_SECRET",
        "E2E_SESSION_COOKIE",
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:reset-seed": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "RESET_CONFIRM",
        "KEEP_USER_EMAIL",
        "SKIP_ENV_VALIDATION",
        "ENCRYPTION_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN"
      ]
    }
  }
}
