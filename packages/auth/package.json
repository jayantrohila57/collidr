{
  "name": "@env-manager/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./session-types": {
      "default": "./src/session-types.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@env-manager/actions": "workspace:*",
    "@env-manager/db": "workspace:*",
    "@env-manager/env": "workspace:*",
    "@env-manager/notifications": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@env-manager/config": "workspace:*",
    "typescript": "catalog:"
  }
}
