{
  "name": "@collidr/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./session-types": {
      "default": "./src/session-types.ts"
    },
    "./return-to": {
      "default": "./src/return-to.ts"
    },
    "./platform-auth": {
      "default": "./src/create-platform-auth.ts"
    },
    "./sibling-auth": {
      "default": "./src/create-sibling-auth.ts"
    },
    "./platform-middleware": {
      "default": "./src/platform-middleware.ts"
    },
    "./guards": {
      "default": "./src/guards/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test src/return-to.test.ts src/guards/session-access.test.ts src/session-cookies.test.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.7",
    "@better-auth/mcp": "^1.7.7",
    "@collidr/actions": "workspace:*",
    "@collidr/db": "workspace:*",
    "@collidr/env": "workspace:*",
    "@collidr/notifications": "workspace:*",
    "@collidr/ui": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@collidr/config": "workspace:*",
    "next": "catalog:",
    "tsx": "^4.19.4",
    "typescript": "catalog:"
  }
}
