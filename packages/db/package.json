{
  "name": "@env-manager/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-seed": "tsx scripts/reset-seed.ts",
    "test": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://localhost:5432/test node --import tsx --test src/connection-url.test.ts src/account-soft-delete.test.ts src/soft-delete.test.ts"
  },
  "dependencies": {
    "@env-manager/crypto": "workspace:*",
    "@env-manager/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@env-manager/config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
