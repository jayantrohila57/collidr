{
  "name": "@loftlancer/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-seed": "tsx scripts/reset-seed.ts",
    "test": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://localhost:5432/test node --import tsx --test src/connection-url.test.ts src/account-soft-delete.test.ts src/soft-delete.test.ts src/e2e-demo-variables.test.ts"
  },
  "dependencies": {
    "@loftlancer/crypto": "workspace:*",
    "@loftlancer/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@loftlancer/config": "workspace:*",
    "@types/pg": "catalog:",
    "better-auth": "catalog:",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
