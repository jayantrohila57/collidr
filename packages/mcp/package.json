{
  "name": "@env-manager/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres SKIP_ENV_VALIDATION=1 node --import tsx --test src/mcp-auth.test.ts src/mcp-tools.test.ts"
  },
  "dependencies": {
    "@env-manager/actions": "workspace:*",
    "@env-manager/api": "workspace:*",
    "@env-manager/db": "workspace:*",
    "@env-manager/env": "workspace:*",
    "@better-auth/mcp": "^1.7.7",
    "drizzle-orm": "catalog:",
    "jose": "^6.2.3",
    "mcp-handler": "^2.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@env-manager/config": "workspace:*",
    "tsx": "^4.19.4",
    "typescript": "catalog:"
  }
}
