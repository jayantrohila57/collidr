{
  "name": "@loftlancer/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres SKIP_ENV_VALIDATION=1 node --import tsx --test src/mcp-auth.test.ts src/mcp-tools.test.ts"
  },
  "dependencies": {
    "@loftlancer/actions": "workspace:*",
    "@loftlancer/auth": "workspace:*",
    "@loftlancer/api": "workspace:*",
    "@loftlancer/db": "workspace:*",
    "@loftlancer/env": "workspace:*",
    "@better-auth/mcp": "^1.7.7",
    "drizzle-orm": "catalog:",
    "jose": "^6.2.12",
    "mcp-handler": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loftlancer/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
