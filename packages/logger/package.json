{
  "name": "@loftlancer/logger",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./sentry": {
      "default": "./src/sentry.ts"
    },
    "./sentry-test": {
      "default": "./src/sentry-test.ts"
    },
    "./sentry-instrument": {
      "default": "./src/sentry-instrument.ts"
    },
