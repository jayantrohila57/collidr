{
  "name": "loftlancer",
  "version": "1.8.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' turbo build --concurrency=2",
    "check-types": "turbo check-types",
    "test": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://localhost:5432/test turbo test",
    "dev:docs": "turbo -F docs dev",
    "dev:auth": "turbo -F auth dev",
    "dev:studio": "turbo -F studio dev",
    "db:push": "turbo -F @loftlancer/db db:push",
    "db:studio": "turbo -F @loftlancer/db db:studio",
    "db:generate": "turbo -F @loftlancer/db db:generate",
    "db:migrate": "turbo -F @loftlancer/db db:migrate",
    "db:reset-seed": "turbo -F @loftlancer/db db:reset-seed",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check-routes": "bash scripts/check-route-literals.sh",
    "fix": "biome check --write --unsafe .",
    "prepare": "husky",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "version-check": "node -p \"require('./package.json').version\"",
    "changelog-check": "type CHANGELOG.md | more"
  },
  "dependencies": {
    "@loftlancer/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@loftlancer/config": "workspace:*",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=12.11.2"
  }
}
