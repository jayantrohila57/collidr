{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/studio/api/cron/purge-apps", "schedule": "30 21 * * *" }
  ],
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 pnpm turbo run build --filter=docs"
    },
    "auth": {
      "root": "apps/auth",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 NEXT_BASE_PATH=/auth pnpm turbo run build --filter=auth"
    },
    "studio": {
      "root": "apps/studio",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 NEXT_BASE_PATH=/studio pnpm turbo run build --filter=studio"
    }
  },
  "rewrites": [
    {
      "source": "/auth",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/auth/:path*",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/studio",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/studio/:path*",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "docs"
      }
    }
  ]
}
