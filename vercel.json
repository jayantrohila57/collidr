{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/app VERCEL_SERVICES=1 pnpm turbo run build --filter=web",
      "bindings": [
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "AUTH_SERVICE_URL"
        }
      ]
    },
    "www": {
      "root": "apps/www",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 pnpm turbo run build --filter=www"
    },
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/docs VERCEL_SERVICES=1 pnpm turbo run build --filter=docs"
    },
    "auth": {
      "root": "apps/auth",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/auth VERCEL_SERVICES=1 PLATFORM_AUTH_ENABLE_MCP=1 pnpm turbo run build --filter=auth"
    },
    "account": {
      "root": "apps/account",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/account VERCEL_SERVICES=1 pnpm turbo run build --filter=account"
    },
    "studio": {
      "root": "apps/studio",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/studio VERCEL_SERVICES=1 pnpm turbo run build --filter=studio",
      "bindings": [
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "AUTH_SERVICE_URL"
        }
      ]
    },
    "console": {
      "root": "apps/console",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/console VERCEL_SERVICES=1 pnpm turbo run build --filter=console"
    },
    "mcp": {
      "root": "apps/mcp",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 pnpm turbo run build --filter=mcp",
      "bindings": [
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "AUTH_SERVICE_URL"
        }
      ]
    },
    "support": {
      "root": "apps/support",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && NEXT_BASE_PATH=/support VERCEL_SERVICES=1 pnpm turbo run build --filter=support"
    }
  },
  "rewrites": [
    {
      "source": "/docs/:path*",
      "destination": { "service": "docs" }
    },
    {
      "source": "/auth/:path*",
      "destination": { "service": "auth" }
    },
    {
      "source": "/account/:path*",
      "destination": { "service": "account" }
    },
    {
      "source": "/console/:path*",
      "destination": { "service": "console" }
    },
    {
      "source": "/support/:path*",
      "destination": { "service": "support" }
    },
    {
      "source": "/studio/:path*",
      "destination": { "service": "studio" }
    },
    {
      "source": "/api/mcp",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/api/mcp/:path*",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/.well-known/openid-configuration/:path*",
      "destination": { "service": "mcp" }
    },
    {
      "source": "/app",
      "destination": { "service": "web" }
    },
    {
      "source": "/app/:path*",
      "destination": { "service": "web" }
    },
    {
      "source": "/",
      "destination": { "service": "www" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "www" }
    }
  ]
}
