{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "$comment": "Single Vercel project (Services): docs at /, auth (incl. account settings) at /auth, studio at /studio. Same-origin cookies on loftlancer.com.",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=docs",
      "env": { "VERCEL_SERVICES": "1" }
    },
    "auth": {
      "root": "apps/auth",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=auth",
      "env": { "VERCEL_SERVICES": "1", "NEXT_BASE_PATH": "/auth" }
    },
    "studio": {
      "root": "apps/studio",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm turbo run build --filter=studio",
      "env": { "VERCEL_SERVICES": "1", "NEXT_BASE_PATH": "/studio" }
    }
  },
  "rewrites": [
    { "source": "/auth", "destination": { "service": "auth" } },
    { "source": "/auth/:path*", "destination": { "service": "auth" } },
    { "source": "/studio", "destination": { "service": "studio" } },
    { "source": "/studio/:path*", "destination": { "service": "studio" } },
    { "source": "/", "destination": { "service": "docs" } },
    { "source": "/:path*", "destination": { "service": "docs" } }
  ]
}
